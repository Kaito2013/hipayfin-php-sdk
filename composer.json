{
  "name": "lucas/hipayfin-php-sdk",
  "description": "HiPayFin Merchant Payment Gateway PHP SDK for PHP 5.6+",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lucas Dev",
      "homepage": "https://github.com/lucas"
    }
  ],
  "require": {
    "php": ">=5.6.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^5.7 || ^9.0"
  },
  "autoload": {
    "psr-4": {
      "Lucas\\HiPayFin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lucas\\HiPayFin\\Tests\\": "tests/"
    }
  }
}
